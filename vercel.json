{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "regions": ["iad1"],
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.js": {
      "includeFiles": "src/{views,db/migrations}/**",
      "maxDuration": 30,
      "memory": 1024
    }
  }
}
