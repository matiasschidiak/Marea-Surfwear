<%- include('icons') %>
<a class="skip-link" href="#main">Saltar al contenido</a>

<header class="site-header<%= store.announcement ? ' has-announce' : '' %>" id="site-header">
  <% if (store.announcement) { %>
  <div class="announce"><p><%= store.announcement %></p></div>
  <% } %>
  <div class="bar container">
    <button class="icon-btn nav-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <span class="when-closed"><%- icon('menu') %></span><span class="when-open"><%- icon('close') %></span>
    </button>

    <a class="logo" href="/" aria-label="<%= store.brand_name %> <%= store.brand_tagline %> - Inicio">
      <%- icon('wave', 'logo__mark') %>
      <span class="logo__word"><%= store.brand_name %></span>
      <span class="logo__tag"><%= store.brand_tagline %></span>
    </a>

    <nav class="nav" id="site-nav" aria-label="Principal">
      <a href="/#catalogo">Mallas</a>
      <a href="/#destacados">Destacados</a>
      <a href="/envios" <% if (path === '/envios') { %>aria-current="page"<% } %>>Envíos</a>
      <a href="/preguntas-frecuentes" <% if (path === '/preguntas-frecuentes') { %>aria-current="page"<% } %>>Preguntas</a>
      <a href="/contacto" <% if (path === '/contacto') { %>aria-current="page"<% } %>>Contacto</a>
      <a class="nav__wa" href="<%= waLink() %>" target="_blank" rel="noopener"><%- icon('whatsapp') %> WhatsApp</a>
    </nav>

    <button class="icon-btn cart-btn" type="button" aria-label="Ver carrito" data-cart-open>
      <%- icon('bag') %>
      <span class="cart-count" data-cart-count hidden>0</span>
    </button>
  </div>
</header>
<div class="nav-backdrop" data-nav-close hidden></div>
