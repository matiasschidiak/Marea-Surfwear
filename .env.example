# Copiá este archivo como ".env" y completalo. NUNCA subas el .env a GitHub.
# En Vercel estas mismas variables se cargan en: Project → Settings → Environment Variables.

# --- Servidor ---
PORT=3000
# En tu computadora: development. En producción: production (Vercel ya lo pone solo).
NODE_ENV=development
# URL de la tienda (sin barra final). Local: http://localhost:3000
# En producción poné tu dominio, por ejemplo https://www.tutienda.com.ar
# (si lo dejás vacío en Vercel se usa la dirección .vercel.app del proyecto)
SITE_URL=http://localhost:3000
# En Vercel se activa solo. Poné 1 si usás Nginx / Render / Cloudflare delante.
TRUST_PROXY=0

# --- Base de datos (PostgreSQL de Supabase) ---
# En producción es OBLIGATORIA. Supabase → botón "Connect" → "Transaction pooler" (puerto 6543).
# Ejemplo: postgresql://postgres.abcdefgh:TU_CLAVE@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Si tu clave tiene símbolos (@ : / # ?) hay que escribirlos codificados (ej: @ -> %40).
# En tu computadora podés dejarla VACÍA: se usa un Postgres embebido en data/pglite, sin instalar nada.
DATABASE_URL=

# --- Fotos (Supabase Storage) ---
# URL del proyecto (Supabase → Project Settings → API → Project URL) y la clave secreta "service_role".
# La clave service_role es SECRETA: solo va en este archivo y en Vercel, jamás en el código ni en GitHub.
# Si las dejás vacías, las fotos se guardan en la carpeta local public/uploads (solo para tu computadora).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Nombre del bucket de fotos (se crea solo, público)
SUPABASE_BUCKET=productos

# --- Base vieja (solo para importarla una vez) ---
# Archivo SQLite anterior; lo usa "npm run db:import-sqlite"
DATABASE_PATH=data/marea.db
# Carpeta local de fotos (solo desarrollo, o para subir las viejas a Supabase al importar)
UPLOADS_DIR=public/uploads

# --- Tienda (valores iniciales; luego se editan desde Admin → Configuración) ---
# WhatsApp que recibe los pedidos: código de país + número, solo dígitos.
# +54 299 415-4002  ->  542994154002
# Si al abrir el chat WhatsApp no encuentra el número, probá con el 9 de celulares argentinos: 5492994154002
WHATSAPP_NUMBER=542994154002
CONTACT_EMAIL=
STORE_ADDRESS=Neuquén Capital, Argentina
INSTAGRAM_URL=
TIKTOK_URL=
FACEBOOK_URL=
# Un talle con esta cantidad o menos se marca como "Últimas unidades"
LOW_STOCK_THRESHOLD=3

# --- Panel de administración ---
# Horas que dura la sesión del administrador
ADMIN_SESSION_HOURS=12
# Administrador inicial: solo se crea si todavía no existe ninguno (útil en el primer arranque en Vercel).
# Después podés borrar estas dos variables. La contraseña se cambia desde el panel (Mi cuenta).
ADMIN_EMAIL=
ADMIN_PASSWORD=
