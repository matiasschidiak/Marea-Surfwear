{
  "name": "marea-surfwear",
  "version": "1.0.0",
  "description": "Tienda online MAREA Surfwear: catálogo, carrito, pedidos por WhatsApp, stock por talle y panel de administración.",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node scripts/db-init.js",
    "db:seed": "node scripts/db-seed.js",
    "setup": "node scripts/db-init.js && node scripts/db-seed.js",
    "admin:create": "node scripts/create-admin.js",
    "art:generate": "node scripts/generate-art.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\""
  },
  "keywords": ["surf", "ecommerce", "whatsapp"],
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.2",
    "dotenv": "^18.0.5",
    "ejs": "^7.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "sharp": "^0.35.5"
  }
}
